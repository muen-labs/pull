# ── Step 1 · app ────────────────────────────────────────────────────────
# Copy to .env.local and fill in as each service is connected.
# Run `npm run check` to see what is configured and what still needs a key.

# ── Step 2 · Neon (database) ────────────────────────────────────────────
# Neon dashboard → your project → Connect → "Node.js" → copy the pooled connection string.
DATABASE_URL=

# ── Step 3 · Cloudinary (images + crop) ─────────────────────────────────
# Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Step 4 · Resend (email) ─────────────────────────────────────────────
# Resend dashboard → API Keys. RESEND_FROM must be on a verified domain,
# or use onboarding@resend.dev while testing (it can only send to your own address).
RESEND_API_KEY=
RESEND_FROM="PULL <onboarding@resend.dev>"
# No verified domain yet? onboarding@resend.dev is a hard 403 for any recipient other than your
# own account address. Set this to one inbox and every non-stylist message is captured there
# (real recipients move into the subject). Remove it before sending for real.
RESEND_REDIRECT_TO=

# ── Step 5 · Shippo (labels) ────────────────────────────────────────────
# Shippo dashboard → Settings → API → "Test" token first, then "Live".
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_SECRET=
# Live keys only: set to "true" to allow real label purchases (costs money).
SHIPPO_ALLOW_PURCHASE=false

# ── Security ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
LINK_SECRET=
# One address or a comma-separated list. Only these can request a magic-link login,
# so a second device/account can be tested without touching code.
AUTH_ALLOWED_EMAIL=

# ── Optional ────────────────────────────────────────────────────────────
# Public base URL used in emailed links. Leave empty for localhost. To open a mailed link on a
# second device on the same Wi-Fi, set your LAN address: http://192.168.1.41:3000
PUBLIC_BASE_URL=
# Optional LLM polish for brand names and email tone; the demo works without it.
OPENAI_API_KEY=

# ── Agent inference ─────────────────────────────────────────────────────
# Pre-credit demo: DeepSeek (OpenAI-compatible). Set the key yourself; never paste it in chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ZooWork Managed Agents (hackathon sponsor). Leave ZOOWORK_ENABLED unset/false until the
# Agent-creation plan is approved — Agent tasks draw on the organization's prepaid balance.
ZOOWORK_API_KEY=
ZOOWORK_ENABLED=
# ZOOWORK_MODEL=litellm/gpt-5.6-terra   # optional pin; otherwise the platform default

# ── Block Convey PRISM (optional) ────────────────────────────────────────
# Observability for the agent's model calls: prompts, outputs, latency, grouped by job.
# Off unless all three are set. The prompt leaves the machine when it is on, so seeded demo
# data only — real client copy makes Block Convey a subprocessor. Keys are shown once.
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
